# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.cs]
indent_size = 4
charset = utf-8

# migracije generira `dotnet ef migrations add` z BOM kodiranjem
[backend/SolarGuard.Api/Migrations/*.cs]
charset = utf-8-bom

[*.md]
max_line_length = off
trim_trailing_whitespace = false
